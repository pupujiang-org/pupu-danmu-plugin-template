{
  "schema_version": 1,
  "id": "org.pupujiang.fabric-buyer",
  "name": "布料买家",
  "version": "1.0.0",
  "description": "布料直播场景的静态角色与主题资源示例。",
  "author": "pupujiang",
  "license": "MIT",
  "min_host_version": "0.6.0",
  "kind": "ai-participation",
  "runtime_type": "declarative",
  "plugin_api_version": 1,
  "capabilities": ["chat_context", "host_llm", "persona", "topic_hints"],
  "config_schema": {
    "persona": {
      "type": "select",
      "label": "观众角色",
      "description": "仅在当前会话中使用。",
      "required": true,
      "options": ["maker", "buyer"],
      "default": "maker"
    },
    "allow_initiative": {
      "type": "checkbox",
      "label": "允许主动开启话题",
      "default": true
    }
  },
  "recommended_pacing": {
    "min_interval_seconds": 90,
    "max_interval_seconds": 300,
    "hourly_limit": 20
  },
  "resources": {
    "personas": "personas.json",
    "topics": "topics.json",
    "prompt": "prompts/context.md"
  }
}
